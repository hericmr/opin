# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=           # senha forte, sem caracteres especiais como + / =
POSTGRES_DB=opin_prod

# ==========================================
# Imagem Docker do frontend (registry do GitLab)
# ==========================================
FRONT_IMAGE=git.unifesp.br:5050/lindi-opin/opin:latest

# ==========================================
# Frontend / URL Pública
# ==========================================
VITE_API_URL=http://opin.unifesp.br
VITE_API_ANON_KEY=           # chave anon JWT — fornecida pela equipe de desenvolvimento

# ==========================================
# Porta exposta pelo servidor web
# ==========================================
PORT=80
